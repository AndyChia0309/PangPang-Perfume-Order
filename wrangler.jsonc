{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pangpang-perfume-order",
  "main": "worker/index.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "ratelimits": [
    {
      "name": "ORDER_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 5, "period": 60 },
    },
  ],
  "vars": {
    "TURNSTILE_HOSTNAMES": "pangpang-perfume-order.ykk910309.workers.dev",
    "EMAILJS_SERVICE_ID": "service_memoryperfume",
    "EMAILJS_PUBLIC_KEY": "8sn_LHF9Lf1WFOyph",
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
}
